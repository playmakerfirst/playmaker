function buildCard(e){
var ed=dateToLocal(e.dateEvent);
var time=(e.strTime||"").substring(0,5);
var isToday=ed===today,isTomorrow=ed===tomorrow,isYesterday=ed===yesterday;
var hasScore=e.intHomeScore!==null&&e.intHomeScore!==undefined;
var liveNow=hasScore&&e.strStatus==="in";
var idx=currentEvents.indexOf(e);
var hAr=arName(e.strHomeTeam),aAr=arName(e.strAwayTeam);
var dayName="";
try{dayName=new Date(e.dateEvent+"T12:00:00").toLocaleDateString("ar-EG",{weekday:"long",day:"numeric",month:"short"});}
catch(err){dayName=e.dateEvent;}
var badge="";
if(liveNow)badge='<span class="badge live">● مباشر</span>';
else if(isToday&&!hasScore)badge='<span class="badge today">اليوم</span>';
else if(isTomorrow)badge='<span class="badge tomorrow">غدًا</span>';
else if(isYesterday)badge='<span class="badge yesterday">أمس</span>';
else if(hasScore)badge='<span class="badge done">انتهت</span>';
var cardClass=liveNow?"live":(isToday?"today":(hasScore?"played":""));
var scoreClass="";
if(hasScore){
var h=parseInt(e.intHomeScore),a=parseInt(e.intAwayScore);
scoreClass=h>a?"win-home":(a>h?"win-away":"draw-game");
}
var html='<div class="match-card '+cardClass+'" onclick="openMatchByIndex('+idx+')">';
html+='<div class="match-date"><div class="left-side">'+badge+'<span>'+dayName+'</span></div><span>'+time+'</span></div>';
html+='<div class="match-teams">';
html+='<div class="team-row">'+(e.strHomeTeamBadge?'<img class="team-badge" src="'+e.strHomeTeamBadge+'" onerror="this.style.display=\'none\'">':'')+'<div class="team-name">'+hAr+'</div></div>';
html+=hasScore?'<div class="match-score '+scoreClass+'">'+e.intHomeScore+' - '+e.intAwayScore+'</div>':'<div class="match-vs">VS</div>';
html+='<div class="team-row left">'+(e.strAwayTeamBadge?'<img class="team-badge" src="'+e.strAwayTeamBadge+'" onerror="this.style.display=\'none\'">':'')+'<div class="team-name">'+aAr+'</div></div>';
html+='</div></div>';
return html;
}

if(currentDateFilter!=="all"||searchQuery){
var html=searchHTML+filterHTML;
html+='<div class="matches-title"><span>المباريات</span><span class="count-badge">'+events.length+'</span></div>';
