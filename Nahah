<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>المحلل | Al-Muhallil</title>
<style>
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent;font-family:'Segoe UI',Tahoma,Arial,sans-serif}
body{background:#0a0e1a;color:#fff;min-height:100vh;padding-bottom:40px}
header{position:sticky;top:0;z-index:50;background:rgba(10,14,26,.95);backdrop-filter:blur(15px);border-bottom:1px solid rgba(255,255,255,.08);padding:12px 16px}
.logo-wrap{display:flex;align-items:center;gap:10px;background:none;border:none;color:inherit;cursor:pointer}
.logo{width:38px;height:38px;border-radius:12px;background:linear-gradient(135deg,#3b82f6,#a855f7);display:flex;align-items:center;justify-content:center;font-weight:900;font-size:18px}
.logo-text h1{font-size:16px;font-weight:900;background:linear-gradient(135deg,#60a5fa,#a78bfa);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.logo-text p{font-size:10px;color:#94a3b8}
.container{max-width:900px;margin:0 auto;padding:20px 16px}
.hero{text-align:center;margin-bottom:20px}
.hero h2{font-size:24px;font-weight:900;margin-bottom:6px}
.hero p{color:#94a3b8;font-size:13px}
.categories{display:flex;gap:8px;overflow-x:auto;padding-bottom:12px;margin-bottom:16px}
.categories::-webkit-scrollbar{display:none}
.cat-btn{padding:8px 16px;border-radius:20px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);color:#e2e8f0;font-weight:700;font-size:12px;white-space:nowrap;cursor:pointer;flex-shrink:0}
.cat-btn.active{background:#3b82f6;color:#fff;border-color:#3b82f6}
.leagues-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}
@media(min-width:600px){.leagues-grid{grid-template-columns:repeat(3,1fr)}}
.league-card{background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.08);border-radius:14px;padding:16px;text-align:right;cursor:pointer;color:inherit;font-family:inherit}
.league-card:active{transform:scale(.97);background:rgba(59,130,246,.15)}
.league-card .name{font-size:14px;font-weight:900;margin-bottom:4px}
.league-card .name-en{font-size:10px;color:#94a3b8}
.back-btn{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);color:#e2e8f0;padding:8px 16px;border-radius:10px;font-size:13px;font-weight:700;cursor:pointer;margin-bottom:16px;display:inline-flex;align-items:center;gap:6px}
.league-header{background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.08);border-radius:16px;padding:16px;margin-bottom:16px}
.league-header h3{font-size:18px;font-weight:900}
.league-header p{font-size:12px;color:#94a3b8}
.search-box{position:relative;margin-bottom:12px}
.search-box input{width:100%;padding:12px 40px 12px 16px;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);border-radius:12px;color:#fff;font-size:13px;font-family:inherit;outline:none}
.search-box input:focus{border-color:#3b82f6}
.search-box input::placeholder{color:#64748b}
.search-box .icon{position:absolute;left:14px;top:50%;transform:translateY(-50%);color:#64748b;font-size:14px}
.search-box .clear-btn{position:absolute;right:8px;top:50%;transform:translateY(-50%);width:26px;height:26px;border-radius:50%;background:rgba(255,255,255,.1);border:none;color:#94a3b8;font-size:14px;cursor:pointer;display:none}
.search-box.has-text .clear-btn{display:flex;align-items:center;justify-content:center}
.stats-summary{display:grid;grid-template-columns:repeat(4,1fr);gap:6px;margin-bottom:12px}
.sum-box{background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.08);border-radius:10px;padding:8px 4px;text-align:center}
.sum-box .num{font-size:16px;font-weight:900}
.sum-box .lbl{font-size:9px;color:#94a3b8;margin-top:2px}
.sum-box.live .num{color:#ef4444}
.sum-box.done .num{color:#64748b}
.sum-box.soon .num{color:#10b981}
.sum-box.total .num{color:#60a5fa}
.date-filter{display:flex;gap:6px;overflow-x:auto;padding-bottom:10px;margin-bottom:12px}
.date-filter::-webkit-scrollbar{display:none}
.date-btn{padding:6px 12px;border-radius:18px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);color:#cbd5e1;font-size:11px;font-weight:700;white-space:nowrap;cursor:pointer;flex-shrink:0}
.date-btn.active{background:#3b82f6;color:#fff;border-color:#3b82f6}
.date-btn.has-items{border-color:rgba(59,130,246,.5)}
.matches-title{font-size:12px;color:#94a3b8;margin-bottom:10px;display:flex;justify-content:space-between;align-items:center}
.matches-title .count-badge{background:rgba(59,130,246,.2);padding:2px 8px;border-radius:10px;font-size:10px;font-weight:700;color:#60a5fa}
.section-header{display:flex;align-items:center;gap:8px;font-size:12px;font-weight:800;color:#94a3b8;margin:18px 0 8px;padding-right:4px}
.section-header .dot{width:8px;height:8px;border-radius:50%}
.section-header .dot.live{background:#ef4444;animation:pulse 1.5s infinite}
.section-header .dot.today{background:#f59e0b}
.section-header .dot.upcoming{background:#10b981}
.section-header .dot.past{background:#64748b}
@keyframes pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.4;transform:scale(1.3)}}
.match-card{background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.08);border-radius:14px;padding:14px;margin-bottom:8px;width:100%;text-align:right;cursor:pointer;color:inherit;font-family:inherit;position:relative;overflow:hidden}
.match-card:active{transform:scale(.98);background:rgba(59,130,246,.15)}
.match-card.live{border-color:rgba(239,68,68,.5);background:linear-gradient(90deg,rgba(239,68,68,.08),rgba(255,255,255,.05))}
.match-card.live::before{content:'';position:absolute;top:0;right:0;width:3px;height:100%;background:#ef4444}
.match-card.today{border-color:rgba(245,158,11,.3)}
.match-card.today::before{content:'';position:absolute;top:0;right:0;width:3px;height:100%;background:#f59e0b}
.match-card.played{opacity:.85}
.match-date{display:flex;justify-content:space-between;font-size:10px;color:#94a3b8;margin-bottom:10px;align-items:center}
.match-date .left-side{display:flex;align-items:center;gap:6px;flex-wrap:wrap}
.match-teams{display:flex;align-items:center;gap:8px}
.team-row{flex:1;display:flex;align-items:center;gap:6px;overflow:hidden}
.team-row.left{flex-direction:row-reverse}
.team-badge{width:24px;height:24px;object-fit:contain;flex-shrink:0}
.team-name{font-size:13px;font-weight:700;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.match-score{padding:2px 10px;background:rgba(59,130,246,.25);border-radius:6px;font-size:13px;font-weight:900;color:#60a5fa;white-space:nowrap}
.match-score.win-home{background:rgba(59,130,246,.35);color:#93c5fd}
.match-score.win-away{background:rgba(168,85,247,.35);color:#c4b5fd}
.match-score.draw-game{background:rgba(251,191,36,.25);color:#fcd34d}
.match-vs{padding:2px 10px;background:rgba(255,255,255,.06);border-radius:6px;font-size:11px;color:#94a3b8;white-space:nowrap}
.badge{padding:2px 7px;border-radius:5px;font-size:9px;font-weight:800;white-space:nowrap}
.badge.live{background:#ef4444;color:#fff;animation:pulse 1.5s infinite}
.badge.today{background:#f59e0b;color:#fff}
.badge.tomorrow{background:#10b981;color:#fff}
.badge.yesterday{background:#8b5cf6;color:#fff}
.badge.done{background:rgba(100,116,139,.4);color:#cbd5e1}
.pred-header{background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.08);border-radius:18px;padding:20px;text-align:center;margin-bottom:16px}
.pred-league{font-size:11px;color:#60a5fa;font-weight:700;margin-bottom:12px}
.pred-teams{display:flex;align-items:center;justify-content:center;gap:10px;margin-bottom:12px}
.pred-team{flex:1;display:flex;flex-direction:column;align-items:center;gap:6px}
.pred-team img{width:50px;height:50px;object-fit:contain}
.pred-team .name{font-size:14px;font-weight:900;text-align:center}
.pred-vs{font-size:16px;font-weight:900;color:#64748b}
.pred-date{font-size:11px;color:#94a3b8}
.pred-result-box{display:inline-block;padding:8px 20px;background:rgba(59,130,246,.2);border-radius:10px;font-weight:900;margin-top:10px;color:#60a5fa}
.pred-title{text-align:center;margin-bottom:16px}
.pred-title .label{font-size:11px;color:#94a3b8;margin-bottom:4px}
.pred-title .value{font-size:22px;font-weight:900;background:linear-gradient(135deg,#60a5fa,#a78bfa);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.bars-box{background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.08);border-radius:16px;padding:18px;margin-bottom:14px}
.bar-item{margin-bottom:16px}
.bar-item:last-child{margin-bottom:0}
.bar-header{display:flex;justify-content:space-between;align-items:center;font-size:13px;margin-bottom:8px;gap:8px}
.bar-header .label{display:flex;align-items:center;gap:6px;font-weight:700;overflow:hidden}
.bar-header .label img{width:20px;height:20px;object-fit:contain;flex-shrink:0}
.bar-header .label span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.bar-header .value{font-weight:900;flex-shrink:0}
.bar-header .blue{color:#60a5fa}
.bar-header .yellow{color:#fbbf24}
.bar-header .purple{color:#a78bfa}
.bar-track{height:8px;background:rgba(255,255,255,.1);border-radius:10px;overflow:hidden}
.bar-fill{height:100%;border-radius:10px;transition:width 1s ease-out}
.bar-fill.blue{background:linear-gradient(90deg,#3b82f6,#60a5fa)}
.bar-fill.yellow{background:linear-gradient(90deg,#eab308,#fbbf24)}
.bar-fill.purple{background:linear-gradient(90deg,#8b5cf6,#a78bfa)}
.confidence-box{background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.08);border-radius:14px;padding:14px 18px;margin-bottom:14px;display:flex;justify-content:space-between;align-items:center}
.confidence-box .label{font-size:13px;color:#cbd5e1}
.confidence-box .value{font-size:20px;font-weight:900;background:linear-gradient(135deg,#60a5fa,#a78bfa);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.stats-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-bottom:14px}
.stat-box{background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.08);border-radius:14px;padding:14px;text-align:center}
.stat-box .label{font-size:10px;color:#94a3b8;margin-bottom:4px}
.stat-box .value{font-size:22px;font-weight:900;background:linear-gradient(135deg,#60a5fa,#a78bfa);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.score-box{background:linear-gradient(135deg,rgba(59,130,246,.1),rgba(168,85,247,.1));border:1px solid rgba(96,165,250,.3);border-radius:16px;padding:18px;margin-bottom:14px}
.score-box h4{font-size:13px;font-weight:700;color:#cbd5e1;margin-bottom:14px}
.score-options{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.score-opt{background:rgba(255,255,255,.05);border-radius:12px;padding:12px 6px;text-align:center;position:relative}
.score-opt.top1{background:linear-gradient(135deg,rgba(59,130,246,.25),rgba(168,85,247,.25));border:1px solid #60a5fa}
.score-opt .score-val{font-size:22px;font-weight:900;color:#fff;letter-spacing:1px}
.score-opt .score-pct{font-size:11px;color:#60a5fa;margin-top:4px;font-weight:700}
.score-opt .score-rank{position:absolute;top:-6px;right:-6px;width:20px;height:20px;background:#3b82f6;border-radius:50%;font-size:10px;font-weight:900;display:flex;align-items:center;justify-content:center}
.firstgoal-box{background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.08);border-radius:16px;padding:18px;margin-bottom:14px}
.firstgoal-box h4{font-size:13px;font-weight:700;color:#cbd5e1;margin-bottom:12px}
.firstgoal-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.fg-opt{background:rgba(255,255,255,.05);border-radius:12px;padding:14px;text-align:center}
.fg-opt .fg-time{font-size:11px;color:#94a3b8;margin-bottom:6px}
.fg-opt .fg-pct{font-size:22px;font-weight:900;color:#fff}
.fg-opt.early{background:linear-gradient(135deg,rgba(16,185,129,.15),rgba(16,185,129,.05));border:1px solid rgba(16,185,129,.3)}
.fg-opt.early .fg-pct{color:#10b981}
.fg-opt.late{background:linear-gradient(135deg,rgba(245,158,11,.15),rgba(245,158,11,.05));border:1px solid rgba(245,158,11,.3)}
.fg-opt.late .fg-pct{color:#f59e0b}
.halves-box{background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.08);border-radius:16px;padding:18px;margin-bottom:14px}
.halves-box h4{font-size:13px;font-weight:700;color:#cbd5e1;margin-bottom:14px}
.half-row{margin-bottom:16px}
.half-row:last-child{margin-bottom:0}
.half-title{font-size:12px;font-weight:700;margin-bottom:10px;display:flex;align-items:center;gap:6px}
.half-title .icon{width:22px;height:22px;border-radius:6px;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:900}
.half-title.first .icon{background:rgba(59,130,246,.25);color:#60a5fa}
.half-title.second .icon{background:rgba(168,85,247,.25);color:#a78bfa}
.half-teams{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.half-team-stat{background:rgba(255,255,255,.04);border-radius:10px;padding:10px;text-align:center}
.half-team-stat .team{font-size:10px;color:#94a3b8;margin-bottom:4px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.half-team-stat .goals{font-size:20px;font-weight:900}
.half-team-stat.home .goals{color:#60a5fa}
.half-team-stat.away .goals{color:#a78bfa}
.half-total{background:linear-gradient(135deg,rgba(59,130,246,.15),rgba(168,85,247,.15));border-radius:10px;padding:10px;text-align:center;margin-top:8px}
.half-total .lbl{font-size:10px;color:#94a3b8;margin-bottom:2px}
.half-total .val{font-size:18px;font-weight:900;color:#fff}
.factors-box{background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.08);border-radius:16px;padding:18px}
.factors-box h4{font-size:13px;font-weight:700;color:#cbd5e1;margin-bottom:12px}
.factor-item{font-size:13px;color:#e2e8f0;padding:6px 0;display:flex;align-items:center;gap:8px}
.factor-dot{color:#60a5fa}
.loading{position:fixed;inset:0;background:rgba(0,0,0,.7);backdrop-filter:blur(10px);display:none;align-items:center;justify-content:center;z-index:100}
.loading.show{display:flex}
.spinner{width:50px;height:50px;border:4px solid #3b82f6;border-top-color:transparent;border-radius:50%;animation:spin .8s linear infinite;margin:0 auto 12px}
@keyframes spin{to{transform:rotate(360deg)}}
.loading p{font-size:13px;color:#cbd5e1}
.loading .progress{font-size:11px;color:#60a5fa;margin-top:6px;font-weight:700}
.view{display:none}
.view.active{display:block;animation:fadeIn .3s ease-out}
@keyframes fadeIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
footer{text-align:center;color:#64748b;font-size:11px;padding:20px;border-top:1px solid rgba(255,255,255,.08);margin-top:20px}
.no-data{text-align:center;color:#94a3b8;padding:40px 20px;background:rgba(255,255,255,.05);border-radius:14px;font-size:14px}
.debug-info{background:rgba(16,185,129,.1);border:1px solid rgba(16,185,129,.3);border-radius:10px;padding:8px 12px;margin-bottom:10px;font-size:10px;color:#10b981}
.error-box{background:rgba(239,68,68,.1);border:1px solid rgba(239,68,68,.3);border-radius:10px;padding:12px;margin-bottom:10px;font-size:12px;color:#fca5a5}
</style>
</head>
