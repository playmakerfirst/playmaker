function pad(n){return n<10?"0"+n:""+n;}
function formatESPN(d){return ""+d.getFullYear()+pad(d.getMonth()+1)+pad(d.getDate());}
function formatLocal(d){return d.getFullYear()+"-"+pad(d.getMonth()+1)+"-"+pad(d.getDate());}
function offsetESPN(days){var d=new Date();d.setDate(d.getDate()+days);return formatESPN(d);}
function offsetLocal(days){var d=new Date();d.setDate(d.getDate()+days);return formatLocal(d);}
function dateToLocal(dateStr){if(!dateStr)return "";var d=new Date(dateStr);return formatLocal(d);}

