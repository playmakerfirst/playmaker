html+='</div>';
html+='<div class="confidence-box"><span class="label">مستوى الثقة</span><span class="value">'+p.confidence+'%</span></div>';
html+='<div class="score-box"><h4>🎯 النتائج الأكثر احتمالاً</h4><div class="score-options">';
for(var i=0;i<p.topScores.length;i++){
var s=p.topScores[i];
html+='<div class="score-opt '+(i===0?"top1":"")+'">'+(i===0?'<div class="score-rank">1</div>':'')+'<div class="score-val">'+s.score+'</div><div class="score-pct">'+s.prob+'%</div></div>';
}
html+='</div></div>';
html+='<div class="firstgoal-box"><h4>⏱️ توقيت أول هدف</h4><div class="firstgoal-grid">';
html+='<div class="fg-opt early"><div class="fg-time">قبل الدقيقة 30</div><div class="fg-pct">'+p.earlyProb+'%</div></div>';
html+='<div class="fg-opt late"><div class="fg-time">بعد الدقيقة 30</div><div class="fg-pct">'+p.lateProb+'%</div></div>';
html+='</div></div>';
html+='<div class="stats-grid">';
html+='<div class="stat-box"><div class="label">أهداف المضيف</div><div class="value">'+p.homeGoals+'</div></div>';
html+='<div class="stat-box"><div class="label">أهداف الضيف</div><div class="value">'+p.awayGoals+'</div></div>';
html+='<div class="stat-box"><div class="label">ركنيات متوقعة</div><div class="value">'+p.corners+'</div></div>';
html+='<div class="stat-box"><div class="label">بطاقات متوقعة</div><div class="value">'+p.cards+'</div></div>';
html+='</div>';
html+='<div class="halves-box"><h4>⚽ توزيع الأهداف على الشوطين</h4>';
html+='<div class="half-row"><div class="half-title first"><div class="icon">1H</div><span>الشوط الأول</span></div>';
html+='<div class="half-teams">';
html+='<div class="half-team-stat home"><div class="team">'+hAr.substring(0,14)+'</div><div class="goals">'+p.homeH1+'</div></div>';
html+='<div class="half-team-stat away"><div class="team">'+aAr.substring(0,14)+'</div><div class="goals">'+p.awayH1+'</div></div>';
html+='</div>';
html+='<div class="half-total"><div class="lbl">إجمالي الشوط الأول</div><div class="val">'+p.totalH1+'</div></div></div>';
html+='<div class="half-row"><div class="half-title second"><div class="icon">2H</div><span>الشوط الثاني</span></div>';
html+='<div class="half-teams">';
html+='<div class="half-team-stat home"><div class="team">'+hAr.substring(0,14)+'</div><div class="goals">'+p.homeH2+'</div></div>';
html+='<div class="half-team-stat away"><div class="team">'+aAr.substring(0,14)+'</div><div class="goals">'+p.awayH2+'</div></div>';
html+='</div>';
html+='<div class="half-total"><div class="lbl">إجمالي الشوط الثاني</div><div class="val">'+p.totalH2+'</div></div></div>';
html+='</div>';
