function hashStr(s){var h=0;s=String(s);for(var i=0;i<s.length;i++){h=((h<<5)-h)+s.charCodeAt(i);h|=0;}return Math.abs(h);}
function poisson(k,l){if(l<=0)return k===0?1:0;var p=Math.exp(-l);for(var i=1;i<=k;i++)p*=l/i;return p;}

function predict(event){
var h1=hashStr(event.strHomeTeam);
var h2=hashStr(event.strAwayTeam);
var h3=hashStr(event.strHomeTeam+event.strAwayTeam);
var homeStrength=(h1%50)+35;
var awayStrength=(h2%50)+30;
homeStrength+=10;
homeStrength+=(h3%20)-10;
var total=homeStrength+awayStrength;
var homeWin=(homeStrength/total)*70;
var awayWin=(awayStrength/total)*70;
var draw=100-homeWin-awayWin;
if(draw<15)draw=15;
var rem=100-draw;
var ratio=homeWin/(homeWin+awayWin);
homeWin=rem*ratio;
awayWin=rem*(1-ratio);
homeWin=Math.round(homeWin);
awayWin=Math.round(awayWin);
draw=100-homeWin-awayWin;
var confidence=55+(Math.abs(homeWin-awayWin)%30);
var homeGoalsTotal=1+(h1%25)/10;
var awayGoalsTotal=0.8+(h2%20)/10;
var homeH1Factor=0.42+((h3%8)/100);
var awayH1Factor=0.38+((h2%10)/100);
var homeH1=+(homeGoalsTotal*homeH1Factor).toFixed(1);
var homeH2=+(homeGoalsTotal*(1-homeH1Factor)).toFixed(1);
var awayH1=+(awayGoalsTotal*awayH1Factor).toFixed(1);
var awayH2=+(awayGoalsTotal*(1-awayH1Factor)).toFixed(1);
var totalH1=+(homeH1+awayH1).toFixed(1);
var totalH2=+(homeH2+awayH2).toFixed(1);
var scoreList=[];
for(var h=0;h<=5;h++)for(var a=0;a<=5;a++){
scoreList.push({h:h,a:a,prob:poisson(h,homeGoalsTotal)*poisson(a,awayGoalsTotal)});
}
var totalProb=scoreList.reduce(function(s,x){return s+x.prob;},0);
scoreList.forEach(function(x){x.prob=x.prob/totalProb;});
scoreList.sort(function(x,y){return y.prob-x.prob;});
var topScores=scoreList.slice(0,3).map(function(x){return {score:x.h+" - "+x.a,prob:+(x.prob*100).toFixed(1)};});
var totalGoalsExpected=homeGoalsTotal+awayGoalsTotal;
var earlyProb=45+(totalGoalsExpected-2.5)*8+(h3%10)-5;
earlyProb=Math.max(30,Math.min(70,earlyProb));
var lateProb=100-earlyProb;
return {
homeWin:homeWin,draw:draw,awayWin:awayWin,confidence:confidence,
homeGoals:homeGoalsTotal.toFixed(1),awayGoals:awayGoalsTotal.toFixed(1),
cards:3+(h3%4),corners:8+(h3%6),
homeH1:homeH1,homeH2:homeH2,awayH1:awayH1,awayH2:awayH2,
totalH1:totalH1,totalH2:totalH2,topScores:topScores,
earlyProb:Math.round(earlyProb),lateProb:Math.round(lateProb)
};
}

