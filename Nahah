function applyFilters(){
var filtered=allEvents;
if(currentDateFilter!=="all"){
var today=offsetLocal(0),tomorrow=offsetLocal(1),yesterday=offsetLocal(-1),weekEnd=offsetLocal(7);
filtered=filtered.filter(function(e){
if(!e.dateEvent)return false;
var ed=dateToLocal(e.dateEvent);
if(currentDateFilter==="today")return ed===today;
if(currentDateFilter==="tomorrow")return ed===tomorrow;
if(currentDateFilter==="yesterday")return ed===yesterday;
if(currentDateFilter==="week")return ed>=today&&ed<weekEnd;
return true;
});
}
if(searchQuery.length>0){
filtered=filtered.filter(function(e){
var hAr=arName(e.strHomeTeam).toLowerCase(),aAr=arName(e.strAwayTeam).toLowerCase();
var hEn=(e.strHomeTeam||"").toLowerCase(),aEn=(e.strAwayTeam||"").toLowerCase();
return hAr.indexOf(searchQuery)>-1||aAr.indexOf(searchQuery)>-1||hEn.indexOf(searchQuery)>-1||aEn.indexOf(searchQuery)>-1;
});
}
currentEvents=filtered;
renderMatches(filtered);
}

