function pad(n){return n<10?"0"+n:""+n;}
function formatESPN(d){return ""+d.getFullYear()+pad(d.getMonth()+1)+pad(d.getDate());}
function formatLocal(d){return d.getFullYear()+"-"+pad(d.getMonth()+1)+"-"+pad(d.getDate());}
function offsetESPN(days){var d=new Date();d.setDate(d.getDate()+days);return formatESPN(d);}
function offsetLocal(days){var d=new Date();d.setDate(d.getDate()+days);return formatLocal(d);}
function dateToLocal(dateStr){if(!dateStr)return "";var d=new Date(dateStr);return formatLocal(d);}

function showLoading(){document.getElementById("loading").classList.add("show");}
function hideLoading(){document.getElementById("loading").classList.remove("show");}
function setProgress(t){var el=document.getElementById("loadingProgress");if(el)el.textContent=t||"";}

async function fetchESPN(slug,startDate,endDate){
var url=ESPN_SOCCER+"/"+slug+"/scoreboard?dates="+startDate+"-"+endDate+"&limit=500";
console.log("ESPN URL:",url);
try{
var res=await fetch(url);
if(!res.ok){console.error("HTTP:",res.status);return [];}
var text=await res.text();
if(!text||text.trim().length===0)return [];
var data;
try{data=JSON.parse(text);}catch(e){return [];}
console.log("Events:",(data.events||[]).length);
return data.events||[];
}catch(e){console.error("Fetch error:",e);return [];}
}

function normalizeEvent(e,slug){
var comp=e.competitions&&e.competitions[0];
if(!comp)return null;
var home=null,away=null;
if(comp.competitors){
for(var i=0;i<comp.competitors.length;i++){
if(comp.competitors[i].homeAway==="home")home=comp.competitors[i];
if(comp.competitors[i].homeAway==="away")away=comp.competitors[i];
}
}
if(!home||!away)return null;
var state="pre";
if(comp.status&&comp.status.type&&comp.status.type.state)state=comp.status.type.state;
var isPlayed=(state==="post"||state==="in");
var dateStr="",timeStr="";
if(e.date){
var parts=e.date.split("T");
dateStr=parts[0];
if(parts[1])timeStr=parts[1].substring(0,5);
}
return {
idEvent:e.id,
strHomeTeam:(home.team.displayName||home.team.name||""),
strAwayTeam:(away.team.displayName||away.team.name||""),
strHomeTeamBadge:home.team.logo||"",
strAwayTeamBadge:away.team.logo||"",
intHomeScore:isPlayed?(home.score||"0"):null,
intAwayScore:isPlayed?(away.score||"0"):null,
dateEvent:dateStr,
strTime:timeStr,
strStatus:state
};
}

async function openLeague(id){
var league=null;
for(var i=0;i<LEAGUES.length;i++)if(LEAGUES[i].id===id)league=LEAGUES[i];
if(!league)return;
currentLeague=league;
currentDateFilter="all";
searchQuery="";
showLoading();
setProgress("📡 جلب المباريات من ESPN...");

var startDate=offsetESPN(-30);
var endDate=offsetESPN(30);
console.log("Range:",startDate,"to",endDate);

var rawEvents=await fetchESPN(id,startDate,endDate);
var events=[];
for(var i=0;i<rawEvents.length;i++){
var n=normalizeEvent(rawEvents[i],id);
if(n)events.push(n);
}

var today=offsetLocal(0);
events.sort(function(a,b){
var da=a.dateEvent?new Date(a.dateEvent+"T00:00:00Z").getTime():0;
var db=b.dateEvent?new Date(b.dateEvent+"T00:00:00Z").getTime():0;
var ta=new Date(today+"T00:00:00Z").getTime();
var aUp=da>=ta,bUp=db>=ta;
if(aUp&&!bUp)return -1;
if(!aUp&&bUp)return 1;
return aUp?(da-db):(db-da);
});

hideLoading();
setProgress("");
document.getElementById("leagueTitle").textContent=league.ar;
document.getElementById("leagueSub").textContent=league.en;
showView("view-matches");
allEvents=events;
currentEvents=events;
var msg="📡 ESPN • "+events.length+" مباراة";
if(events.length===0)msg="⚠️ لا توجد مباريات في هذه الفترة";
renderMatches(events,msg);
}

function filterByDate(f){currentDateFilter=f;applyFilters();}

function onSearchInput(v){
searchQuery=v.trim().toLowerCase();
var box=document.getElementById("searchBox");
if(v.trim().length>0)box.classList.add("has-text");
else box.classList.remove("has-text");
applyFilters();
}

function clearSearch(){
document.getElementById("searchInput").value="";
searchQuery="";
document.getElementById("searchBox").classList.remove("has-text");
applyFilters();
}

function applyFilters(){
var filtered=allEvents;
if(currentDateFilter!=="all"){
var today=offsetLocal(0),tomorrow=offsetLocal(1),yesterday=offsetLocal(-1),weekEnd=offsetLocal(7);
filtered=filtered.filter(function(e){
if(!e.dateEvent)return false;
var ed=dateToLocal(e.dateEvent);
if(currentDateFilter==="today")return ed===today;
if(currentDateFilter==="tomorrow")return ed===tomorrow;
if(currentDateFilter==="yesterday")return ed===yesterday;
if(currentDateFilter==="week")return ed>=today&&ed<weekEnd;
return true;
});
}
if(searchQuery.length>0){
filtered=filtered.filter(function(e){
var hAr=arName(e.strHomeTeam).toLowerCase(),aAr=arName(e.strAwayTeam).toLowerCase();
var hEn=(e.strHomeTeam||"").toLowerCase(),aEn=(e.strAwayTeam||"").toLowerCase();
return hAr.indexOf(searchQuery)>-1||aAr.indexOf(searchQuery)>-1||hEn.indexOf(searchQuery)>-1||aEn.indexOf(searchQuery)>-1;
});
}
currentEvents=filtered;
renderMatches(filtered);
}

function renderMatches(events,debugInfo){
var today=offsetLocal(0),tomorrow=offsetLocal(1),yesterday=offsetLocal(-1);
var live=0,done=0,soon=0;
for(var i=0;i<allEvents.length;i++){
var e=allEvents[i];
var hasScore=e.intHomeScore!==null&&e.intHomeScore!==undefined;
var ed=dateToLocal(e.dateEvent);
if(hasScore&&e.strStatus==="in")live++;
else if(hasScore)done++;
else if(ed>=today)soon++;
}
var todayCount=0,tomorrowCount=0,yesterdayCount=0;
for(var i=0;i<allEvents.length;i++){
var ed=dateToLocal(allEvents[i].dateEvent);
if(ed===today)todayCount++;
if(ed===tomorrow)tomorrowCount++;
if(ed===yesterday)yesterdayCount++;
}

var summaryHTML='<div class="stats-summary">';
summaryHTML+='<div class="sum-box total"><div class="num">'+allEvents.length+'</div><div class="lbl">إجمالي</div></div>';
summaryHTML+='<div class="sum-box live"><div class="num">'+live+'</div><div class="lbl">مباشر</div></div>';
summaryHTML+='<div class="sum-box done"><div class="num">'+done+'</div><div class="lbl">انتهت</div></div>';
summaryHTML+='<div class="sum-box soon"><div class="num">'+soon+'</div><div class="lbl">قادمة</div></div>';
summaryHTML+='</div>';

var searchHTML='<div class="search-box" id="searchBox"><span class="icon">🔍</span>';
searchHTML+='<input type="text" id="searchInput" placeholder="ابحث عن فريق..." value="'+searchQuery+'" oninput="onSearchInput(this.value)">';
searchHTML+='<button class="clear-btn" onclick="clearSearch()">✕</button></div>';

var filterHTML='<div class="date-filter">';
filterHTML+='<button class="date-btn '+(currentDateFilter==="all"?"active":"")+'" onclick="filterByDate(\'all\')">الكل ('+allEvents.length+')</button>';
filterHTML+='<button class="date-btn '+(currentDateFilter==="yesterday"?"active":"")+(yesterdayCount>0?" has-items":"")+'" onclick="filterByDate(\'yesterday\')">📅 أمس'+(yesterdayCount>0?" ("+yesterdayCount+")":"")+'</button>';
filterHTML+='<button class="date-btn '+(currentDateFilter==="today"?"active":"")+(todayCount>0?" has-items":"")+'" onclick="filterByDate(\'today\')">📅 اليوم'+(todayCount>0?" ("+todayCount+")":"")+'</button>';
filterHTML+='<button class="date-btn '+(currentDateFilter==="tomorrow"?"active":"")+(tomorrowCount>0?" has-items":"")+'" onclick="filterByDate(\'tomorrow\')">📅 غدًا'+(tomorrowCount>0?" ("+tomorrowCount+")":"")+'</button>';
filterHTML+='<button class="date-btn '+(currentDateFilter==="week"?"active":"")+'" onclick="filterByDate(\'week\')">📅 هذا الأسبوع</button>';
filterHTML+='</div>';

var debugHTML=(debugInfo&&currentDateFilter==="all"&&!searchQuery)?('<div class="debug-info">'+debugInfo+'</div>'):"";

if(!events||events.length===0){
document.getElementById("matchesList").innerHTML=summaryHTML+searchHTML+filterHTML+'<div class="no-data">لا توجد مباريات متاحة</div>';
return;
}

function buildCard(e){
var ed=dateToLocal(e.dateEvent);
var time=(e.strTime||"").substring(0,5);
var isToday=ed===today,isTomorrow=ed===tomorrow,isYesterday=ed===yesterday;
var hasScore=e.intHomeScore!==null&&e.intHomeScore!==undefined;
var liveNow=hasScore&&e.strStatus==="in";
var idx=currentEvents.indexOf(e);
var hAr=arName(e.strHomeTeam),aAr=arName(e.strAwayTeam);
var dayName="";
try{dayName=new Date(e.dateEvent+"T12:00:00").toLocaleDateString("ar-EG",{weekday:"long",day:"numeric",month:"short"});}
catch(err){dayName=e.dateEvent;}
var badge="";
if(liveNow)badge='<span class="badge live">● مباشر</span>';
else if(isToday&&!hasScore)badge='<span class="badge today">اليوم</span>';
else if(isTomorrow)badge='<span class="badge tomorrow">غدًا</span>';
else if(isYesterday)badge='<span class="badge yesterday">أمس</span>';
else if(hasScore)badge='<span class="badge done">انتهت</span>';
var cardClass=liveNow?"live":(isToday?"today":(hasScore?"played":""));
var scoreClass="";
if(hasScore){
var h=parseInt(e.intHomeScore),a=parseInt(e.intAwayScore);
scoreClass=h>a?"win-home":(a>h?"win-away":"draw-game");
}
var html='<div class="match-card '+cardClass+'" onclick="openMatchByIndex('+idx+')">';
html+='<div class="match-date"><div class="left-side">'+badge+'<span>'+dayName+'</span></div><span>'+time+'</span></div>';
html+='<div class="match-teams">';
html+='<div class="team-row">'+(e.strHomeTeamBadge?'<img class="team-badge" src="'+e.strHomeTeamBadge+'" onerror="this.style.display=\'none\'">':'')+'<div class="team-name">'+hAr+'</div></div>';
html+=hasScore?'<div class="match-score '+scoreClass+'">'+e.intHomeScore+' - '+e.intAwayScore+'</div>':'<div class="match-vs">VS</div>';
html+='<div class="team-row left">'+(e.strAwayTeamBadge?'<img class="team-badge" src="'+e.strAwayTeamBadge+'" onerror="this.style.display=\'none\'">':'')+'<div class="team-name">'+aAr+'</div></div>';
html+='</div></div>';
return html;
}

if(currentDateFilter!=="all"||searchQuery){
var html=searchHTML+filterHTML;
html+='<div class="matches-title"><span>المباريات</span><span class="count-badge">'+events.length+'</span></div>';
var cards="";
for(var i=0;i<events.length;i++)cards+=buildCard(events[i]);
html+=cards;
document.getElementById("matchesList").innerHTML=html;
return;
}

var liveM=[],todayM=[],tomorrowM=[],upcomingM=[],yesterdayM=[],pastM=[];
for(var i=0;i<events.length;i++){
var e=events[i];
var ed=dateToLocal(e.dateEvent);
var has=e.intHomeScore!==null&&e.intHomeScore!==undefined;
if(has&&e.strStatus==="in")liveM.push(e);
else if(ed===today)todayM.push(e);
else if(ed===tomorrow)tomorrowM.push(e);
else if(ed===yesterday)yesterdayM.push(e);
else if(ed>today)upcomingM.push(e);
else pastM.push(e);
}

function section(title,cls,arr){
if(arr.length===0)return "";
var h='<div class="section-header"><span class="dot '+cls+'"></span><span>'+title+'</span>';
h+='<span style="color:#60a5fa;margin-right:auto;font-size:11px">'+arr.length+'</span></div>';
for(var i=0;i<arr.length;i++)h+=buildCard(arr[i]);
return h;
}

var finalHTML=summaryHTML+searchHTML+filterHTML+debugHTML;
finalHTML+=section("🔴 مباشر الآن","live",liveM);
finalHTML+=section("📅 مباريات اليوم","today",todayM);
finalHTML+=section("📅 مباريات غدًا","upcoming",tomorrowM);
finalHTML+=section("📆 المباريات القادمة","upcoming",upcomingM);
finalHTML+=section("📆 نتائج الأمس","past",yesterdayM);
finalHTML+=section("📆 المباريات السابقة","past",pastM);
document.getElementById("matchesList").innerHTML=finalHTML;
}

function hashStr(s){var h=0;s=String(s);for(var i=0;i<s.length;i++){h=((h<<5)-h)+s.charCodeAt(i);h|=0;}return Math.abs(h);}
function poisson(k,l){if(l<=0)return k===0?1:0;var p=Math.exp(-l);for(var i=1;i<=k;i++)p*=l/i;return p;}

function predict(event){
var h1=hashStr(event.strHomeTeam);
var h2=hashStr(event.strAwayTeam);
var h3=hashStr(event.strHomeTeam+event.strAwayTeam);
var homeStrength=(h1%50)+35;
var awayStrength=(h2%50)+30;
homeStrength+=10;
homeStrength+=(h3%20)-10;
var total=homeStrength+awayStrength;
var homeWin=(homeStrength/total)*70;
var awayWin=(awayStrength/total)*70;
var draw=100-homeWin-awayWin;
if(draw<15)draw=15;
var rem=100-draw;
var ratio=homeWin/(homeWin+awayWin);
homeWin=rem*ratio;
awayWin=rem*(1-ratio);
homeWin=Math.round(homeWin);
awayWin=Math.round(awayWin);
draw=100-homeWin-awayWin;
var confidence=55+(Math.abs(homeWin-awayWin)%30);
var homeGoalsTotal=1+(h1%25)/10;
var awayGoalsTotal=0.8+(h2%20)/10;
var homeH1Factor=0.42+((h3%8)/100);
var awayH1Factor=0.38+((h2%10)/100);
var homeH1=+(homeGoalsTotal*homeH1Factor).toFixed(1);
var homeH2=+(homeGoalsTotal*(1-homeH1Factor)).toFixed(1);
var awayH1=+(awayGoalsTotal*awayH1Factor).toFixed(1);
var awayH2=+(awayGoalsTotal*(1-awayH1Factor)).toFixed(1);
var totalH1=+(homeH1+awayH1).toFixed(1);
var totalH2=+(homeH2+awayH2).toFixed(1);
var scoreList=[];
for(var h=0;h<=5;h++)for(var a=0;a<=5;a++){
scoreList.push({h:h,a:a,prob:poisson(h,homeGoalsTotal)*poisson(a,awayGoalsTotal)});
}
var totalProb=scoreList.reduce(function(s,x){return s+x.prob;},0);
scoreList.forEach(function(x){x.prob=x.prob/totalProb;});
scoreList.sort(function(x,y){return y.prob-x.prob;});
var topScores=scoreList.slice(0,3).map(function(x){return {score:x.h+" - "+x.a,prob:+(x.prob*100).toFixed(1)};});
var totalGoalsExpected=homeGoalsTotal+awayGoalsTotal;
var earlyProb=45+(totalGoalsExpected-2.5)*8+(h3%10)-5;
earlyProb=Math.max(30,Math.min(70,earlyProb));
var lateProb=100-earlyProb;
return {
homeWin:homeWin,draw:draw,awayWin:awayWin,confidence:confidence,
homeGoals:homeGoalsTotal.toFixed(1),awayGoals:awayGoalsTotal.toFixed(1),
cards:3+(h3%4),corners:8+(h3%6),
homeH1:homeH1,homeH2:homeH2,awayH1:awayH1,awayH2:awayH2,
totalH1:totalH1,totalH2:totalH2,topScores:topScores,
earlyProb:Math.round(earlyProb),lateProb:Math.round(lateProb)
};
}

function openMatchByIndex(idx){
var event=currentEvents[idx];
if(!event)return;
var hAr=arName(event.strHomeTeam),aAr=arName(event.strAwayTeam);
var lAr=currentLeague?currentLeague.ar:"";
var hB=event.strHomeTeamBadge||"",aB=event.strAwayTeamBadge||"";
var hasScore=event.intHomeScore!==null&&event.intHomeScore!==undefined;
var actual=hasScore?(event.intHomeScore+" - "+event.intAwayScore):"";
var p=predict(event);
var winner="تعادل";
if(p.homeWin>p.awayWin&&p.homeWin>p.draw)winner=hAr;
else if(p.awayWin>p.draw)winner=aAr;
var html='<div class="pred-header">';
