html+='<div class="bar-item"><div class="bar-header"><span class="label yellow"><span>تعادل</span></span><span class="value">'+p.draw+'%</span></div><div class="bar-track"><div class="bar-fill yellow" style="width:'+p.draw+'%"></div></div></div>';
