async function fetchESPN(slug,startDate,endDate){
var url=ESPN_SOCCER+"/"+slug+"/scoreboard?dates="+startDate+"-"+endDate+"&limit=500";
console.log("ESPN URL:",url);
try{
var res=await fetch(url);
if(!res.ok){console.error("HTTP:",res.status);return [];}
var text=await res.text();
if(!text||text.trim().length===0)return [];
var data;
try{data=JSON.parse(text);}catch(e){return [];}
console.log("Events:",(data.events||[]).length);
return data.events||[];
}catch(e){console.error("Fetch error:",e);return [];}
}

function normalizeEvent(e,slug){
var comp=e.competitions&&e.competitions[0];
if(!comp)return null;
var home=null,away=null;
if(comp.competitors){
for(var i=0;i<comp.competitors.length;i++){
if(comp.competitors[i].homeAway==="home")home=comp.competitors[i];
if(comp.competitors[i].homeAway==="away")away=comp.competitors[i];
}
}
if(!home||!away)return null;
var state="pre";
if(comp.status&&comp.status.type&&comp.status.type.state)state=comp.status.type.state;
var isPlayed=(state==="post"||state==="in");
var dateStr="",timeStr="";
if(e.date){
var parts=e.date.split("T");
dateStr=parts[0];
if(parts[1])timeStr=parts[1].substring(0,5);
}
return {
idEvent:e.id,
strHomeTeam:(home.team.displayName||home.team.name||""),
strAwayTeam:(away.team.displayName||away.team.name||""),
strHomeTeamBadge:home.team.logo||"",
strAwayTeamBadge:away.team.logo||"",
intHomeScore:isPlayed?(home.score||"0"):null,
intAwayScore:isPlayed?(away.score||"0"):null,
dateEvent:dateStr,
strTime:timeStr,
strStatus:state
};
}

async function openLeague(id){
var league=null;
for(var i=0;i<LEAGUES.length;i++)if(LEAGUES[i].id===id)league=LEAGUES[i];
if(!league)return;
currentLeague=league;
currentDateFilter="all";
searchQuery="";
showLoading();
setProgress("📡 جلب المباريات من ESPN...");

var startDate=offsetESPN(-30);
var endDate=offsetESPN(30);
console.log("Range:",startDate,"to",endDate);

var rawEvents=await fetchESPN(id,startDate,endDate);
var events=[];
for(var i=0;i<rawEvents.length;i++){
var n=normalizeEvent(rawEvents[i],id);
if(n)events.push(n);
}

var today=offsetLocal(0);
events.sort(function(a,b){
var da=a.dateEvent?new Date(a.dateEvent+"T00:00:00Z").getTime():0;
var db=b.dateEvent?new Date(b.dateEvent+"T00:00:00Z").getTime():0;
var ta=new Date(today+"T00:00:00Z").getTime();
var aUp=da>=ta,bUp=db>=ta;
if(aUp&&!bUp)return -1;
if(!aUp&&bUp)return 1;
return aUp?(da-db):(db-da);
});

hideLoading();
setProgress("");
document.getElementById("leagueTitle").textContent=league.ar;
document.getElementById("leagueSub").textContent=league.en;
showView("view-matches");
allEvents=events;
currentEvents=events;
var msg="📡 ESPN • "+events.length+" مباراة";
if(events.length===0)msg="⚠️ لا توجد مباريات في هذه الفترة";
renderMatches(events,msg);
}

